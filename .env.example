# =====================================================
# CaterMatch — Environment Variables (copy to .env)
# =====================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://catmatch:catmatch@localhost:5432/catmatch
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# ---- Stripe (Boost payments) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Price IDs created in the Stripe Dashboard
STRIPE_PRICE_3DAY=price_3day_xxx
STRIPE_PRICE_7DAY=price_7day_xxx
STRIPE_PRICE_14DAY=price_14day_xxx