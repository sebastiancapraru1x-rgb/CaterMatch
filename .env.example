# =====================================================
# CaterMatch — Environment Variables (copy to .env)
# =====================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Leave empty for the zero-install embedded DB (PGlite).
# For production, set to Supabase/Neon and DB_DRIVER=postgres.
DATABASE_URL=
DB_DRIVER=embedded

# ---- Demo seed data (dev only) ----
# Controls the fake/demo listings & accounts ("Taco Titan" etc.):
#   * NOT set + NODE_ENV=production → demo data is SKIPPED (public site
#     starts completely empty — only real user listings appear). Default.
#   * NOT set + local dev          → demo data seeds on first boot so you
#     have something to test with.
#   * SEED_DEMO_DATA=false          → force off anywhere.
#   * SEED_DEMO_DATA=true           → force on (local testing only).
SEED_DEMO_DATA=

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- Stripe (Boost payments) ----
# With NO keys set, the app runs in DEV MODE: clicking "Boost"
# simulates a payment and activates the boost instantly (free, no
# Stripe account needed).
#
# To take real money: create a free Stripe account, grab the Test
# secret key, and set a webhook endpoint to /api/boosts/stripe/webhook.
# Copy the "whsec_..." signing secret below. Keep test-mode keys until
# you're ready to go live, then swap in the live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Staff / Developer allowlist (comma-separated emails) ----
# These are the people who work on / test the app (you + teammates).
#   • They get FREE simulated boosts even after Stripe is connected,
#     so testing never costs real money.
#   • They see staff-only internal status (e.g. Stripe mode) in the UI.
# Everyone else pays real Stripe and never sees internal dev info.
# Leave EMPTY to disable all staff perks (production default).
DEV_MODE_EMAILS=